# bridge/.env にコピーして使う。このファイル自体は値を入れずにコミットする。
# .env は .gitignore 済み。実際のキーは絶対にコミットしない。
#
# 認証情報はアプリの設定画面(設定… → Discord →「認証情報」)からも入れられる。
# その場合の保存先は ~/.mihari/.env(MIHARI_SETTINGS_DIR があればそのディレクトリ)で、
# 読む順は「実環境変数 > ~/.mihari/.env > bridge/.env」。画面から入れた方が優先される。

# iPhone のスクショを読むのに使う Gemini API のキー。
# 未設定でもアプリは動く(画面には触れず、同封の固定文言のセリフになる)。
GEMINI_API_KEY=

# スクショを読むモデル。未設定なら gemini-3.1-flash-lite(喋り出しの速さ優先)。
MIHARI_SCREEN_MODEL=gemini-3.1-flash-lite

# スクショを送る解像度。low / medium / high。未設定なら medium。
# アプリ名が読めれば十分なので、上げるのは読み違いが多いときだけにする。
MIHARI_SCREEN_MEDIA_RESOLUTION=medium

# ---- VOICEVOX ----
# アプリは既定で同封済みの固定セリフ音声を鳴らすので、VOICEVOX は使わない。
# アプリ側を MIHARI_VOICE_MODE=live で起動したときだけ、以下の設定で合成する。

# VOICEVOX エンジンの場所。未設定なら http://127.0.0.1:50021
MIHARI_VOICEVOX_URL=

# VOICEVOX の話者 ID。未設定なら 14(冥鳴ひまり)。/speakers で一覧を引ける。
MIHARI_VOICEVOX_SPEAKER=

# ---- Discord ----
# Discord Developer Portal (https://discord.com/developers/applications) で
# アプリケーションを作って取得する。未設定でもアプリは動く(晒せなくなるだけ)。
#
# 1. New Application でアプリを作る
# 2. 「General Information」の APPLICATION ID を DISCORD_CLIENT_ID に入れる
# 3. 「Bot」タブで Reset Token して DISCORD_BOT_TOKEN に入れる
#    ※ トークンは認証情報。絶対にコミットしない(bridge/.env は .gitignore 済み)
# 4. アプリの「Discord」タブから招待 URL を開き、自分のサーバに Bot を入れる
# 5. アプリで投稿先チャンネルを選ぶ

DISCORD_CLIENT_ID=
DISCORD_BOT_TOKEN=

# 投稿先チャンネルとメンション先の保存場所。未設定なら ~/.mihari
# メンション先(通知するユーザー)に環境変数は無い。アプリの Discord 設定画面から選ぶ。
MIHARI_SETTINGS_DIR=
